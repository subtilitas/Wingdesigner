{
  "name": "wingdesigner",
  "version": "0.1.0",
  "description": "Browser-based RC wing designer: NURBS loft through airfoil sections, guide curves, STEP/STL/3MF export",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:readme": "node scripts/coverage-readme.mjs",
    "coverage:check": "node scripts/coverage-readme.mjs --check",
    "airfoils:check": "node scripts/check-airfoils.mjs",
    "e2e": "playwright test",
    "step:cases": "node scripts/export-step-cases.mjs step-check",
    "screenshots": "node scripts/screenshots.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
